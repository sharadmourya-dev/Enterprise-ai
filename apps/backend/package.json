{
  "name": "@enterprise-ai/backend",
  "version": "1.0.0",
  "description": "Enterprise AI Knowledge & Support Copilot REST API & Backend Services",
  "private": true,
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx src/worker.ts",
    "build": "tsc -b",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.cjs --runInBand --detectOpenHandles --forceExit",
    "test:unit": "jest --config jest.config.unit.cjs --runInBand --detectOpenHandles",
    "test:integration": "jest --config jest.config.integration.cjs --runInBand --detectOpenHandles --forceExit",
    "eval:rag": "tsx src/evaluation/run-eval.ts",
    "admin:promote": "tsx src/scripts/promote-user.ts"
  },
  "dependencies": {
    "@enterprise-ai/shared-types": "*",
    "@google/genai": "^2.30.0",
    "@qdrant/js-client-rest": "^1.19.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^6.3.17",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.13.0",
    "mongoose": "^8.9.5",
    "multer": "^2.4.0",
    "openai": "^7.39.0",
    "pdf-parse": "^2.4.5",
    "uuid": "^14.0.3",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.7",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
