# Environment files and secrets (strictly excluded)
.env
.env.*
*.env
!.env.example
!.env.sample

# Dependencies
node_modules/
.pnp/
.pnp.js

# Build outputs
dist/
build/
.next/
out/
coverage/
*.tsbuildinfo

# Persistent data volumes, local uploads, and databases
infrastructure/data/
apps/backend/data/
/data/
*.db
*.sqlite

# Keep synthetic evaluation dataset
!apps/backend/src/evaluation/data/
!apps/backend/src/evaluation/data/**

# Testing & coverage
coverage/
*.lcov
.nyc_output/

# Logs and runtime artifacts
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
*.seed
*.pid.lock

# Local caches and temporary files
.cache/
.tmp/
temp/
tmp/

# Local environment and operating-system files
.DS_Store
Thumbs.db
desktop.ini

# Editor-specific state
.idea/
.vscode/
*.swp
*.swo

# Secrets and keys
*.pem
*.key
*.cert
*.crt
credentials.json
service-account*.json
