{
  "name": "enterprise-ai-copilot",
  "version": "1.0.0",
  "description": "Enterprise AI Knowledge & Support Copilot",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "infra:up": "docker compose -f infrastructure/docker-compose.infra.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker-compose.infra.yml down",
    "infra:logs": "docker compose -f infrastructure/docker-compose.infra.yml logs -f",
    "infra:status": "docker compose -f infrastructure/docker-compose.infra.yml ps",
    "admin:promote": "npm run admin:promote --workspace=@enterprise-ai/backend --"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
